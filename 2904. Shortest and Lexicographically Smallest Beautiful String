class Solution:
    def shortestBeautifulSubstring(self, s: str, k: int) -> str:
        n = len(s)
        ans = ""

        for i in range(n):
            count = 0

            for j in range(i, n):
                if s[j] == '1':
                    count += 1

                if count == k:
                    current = s[i:j + 1]

                    if ans == "" or len(current) < len(ans):
                        ans = current
                    elif len(current) == len(ans) and current < ans:
                        ans = current

                    break

                if count > k:
                    break

        return ans
